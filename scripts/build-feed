#!/bin/sh
# Собрать пакеты фида halo в SDK из последних исходников и обновить фиды ipk (docs/feeds.md):
#
#   scripts/build-feed [-v] <SDK> [пакет…]
#
#   -v      — весь вывод make (V=s) в терминал; без него — только ход сборки (какой пакет
#             собирается, что собралось, что нет), полный вывод — в <SDK>/logs/build-feed.log,
#             журнал каждого пакета — <SDK>/logs/package/feeds/halo/<каталог>/compile.txt;
#   <SDK>   — каталог SDK OpenWrt, в feeds.conf которого этот репозиторий — src-link halo;
#   пакеты  — имена пакетов или каталогов фида (halo-preview, zenith-uc, halo-metrics-collectd —
#             по индексу фида SDK собирается их каталог: halo, horizon-uc, halo-metrics);
#             по умолчанию — список scripts/feed-packages (актуальные: Halo и модули,
#             halo-metrics, opkg-repository, horizon-uc, aurora-uc).
#
# Halo — из последнего коммита ветки main donyx (halo.mk; HALO_COMMIT=<хеш>, HALO_BRANCH=<ветка>
# — другой), номер выпуска — время сборки, один на все пакеты. Шаги: git pull этого клона (если
# в нём нет локальных изменений), feeds update/install, прежние ipk пакетов — прочь (в индексе
# одна версия), clean + compile всех вместе (модули — под рантайм своей сборки Halo),
# make package/index (подписанные индексы всех фидов). Запускать на машине сборки.
set -e

die() { echo "build-feed: $*" >&2; exit 1; }
say() { echo "build-feed: $*"; }

VERBOSE=
[ "$1" != "-v" ] || { VERBOSE=1; shift; }
[ -n "$1" ] || die "usage: $0 [-v] <SDK> [package…]"
SDK=$(cd "$1" && pwd) || die "no SDK directory $1"
shift
[ -x "$SDK/scripts/feeds" ] || die "$SDK is not an OpenWrt SDK"
FEED=$(cd "$(dirname "$0")/.." && pwd)

# пакеты по умолчанию — scripts/feed-packages (без комментариев и пустых строк)
if [ $# -eq 0 ]; then
	set -- $(sed -e 's/#.*//' "$FEED/scripts/feed-packages" | tr -s ' \t' '\n' | grep -v '^$')
fi
# этот клон — свежий, если в нём нет своих правок (иначе собираем как есть)
if [ -d "$FEED/.git" ]; then
	if [ -z "$(git -C "$FEED" status --porcelain)" ]; then
		git -C "$FEED" pull --ff-only -q || echo "build-feed: git pull failed, building the current files" >&2
	else
		echo "build-feed: $FEED has local changes, no git pull" >&2
	fi
	say "feed: $(git -C "$FEED" log -1 --format='%h %s')"
fi

cd "$SDK"
./scripts/feeds update halo >/dev/null

# имя пакета -> каталог фида: каталог как есть, иначе — по индексу фида SDK (feeds/halo.index:
# Source-Makefile каталога, затем его Package:); из одного каталога может быть несколько пакетов
dir_of() {
	if [ -f "$FEED/$1/Makefile" ]; then echo "$1"; return; fi
	awk -v want="$1" '
		/^Source-Makefile:/ { n = split($2, a, "/"); dir = a[n - 1] }
		/^Package:/ && $2 == want { print dir; exit }
	' feeds/halo.index
}
dirs=""
for p in "$@"; do
	d=$(dir_of "$p")
	[ -n "$d" ] || die "no package $p in the feed $FEED"
	case " $dirs " in *" $d "*) ;; *) dirs="$dirs $d" ;; esac
done
# shellcheck disable=SC2086
set -- $dirs
say "packages: $*"

./scripts/feeds install -p halo "$@" >/dev/null

ARCH=$(ls bin/packages 2>/dev/null | head -1)
[ -n "$ARCH" ] || ARCH=$(sed -n 's/^CONFIG_TARGET_ARCH_PACKAGES="\(.*\)"/\1/p' .config)
OUT=bin/packages/$ARCH/halo

cleans=""
compiles=""
for p in "$@"; do
	cleans="$cleans package/feeds/halo/$p/clean"
	compiles="$compiles package/feeds/halo/$p/compile"
done

# метка начала: что собрано в этот запуск — файлы новее неё
mkdir -p "$OUT" logs
STAMP=$(mktemp)
START=$(date +%s)
export HALO_RELEASE="${HALO_RELEASE:-$(date -u +%y%m%d%H%M)}"
# Halo и модули — из одного коммита donyx: его узнаём один раз здесь, а не halo.mk в каждом
# пакете (запушенный посреди сборки коммит иначе попал бы только в часть модулей)
if [ -z "$HALO_COMMIT" ]; then
	url=$(sed -n 's/^PKG_SOURCE_URL:=//p' "$FEED/halo.mk")
	HALO_COMMIT=$(git ls-remote "$url" "refs/heads/${HALO_BRANCH:-main}" 2>/dev/null | cut -f1)
	[ -z "$HALO_COMMIT" ] || export HALO_COMMIT HALO_LATEST=1
fi
if [ -n "$HALO_COMMIT" ]; then
	say "Halo: donyx $(echo "$HALO_COMMIT" | cut -c1-8) (${HALO_BRANCH:-main}), release r$HALO_RELEASE"
else
	say "Halo: no access to GitHub, the pinned commit of halo.mk, release r$HALO_RELEASE"
fi

LOG=logs/build-feed.log
# clean — отдельным make и до сборки: цели одной командной строки make -j выполняет вперемешку,
# clean пакета выполнялся и после его же compile и удалял только что собранный ipk; -k — ошибка
# одного пакета не останавливает сборку остальных (прежние ipk clean уже удалил)
if [ -n "$VERBOSE" ]; then
	# shellcheck disable=SC2086
	make $cleans V=s
	# shellcheck disable=SC2086
	make -k $compiles -j"$(nproc)" V=s || failed=1
else
	say "clean, compile (full output: $SDK/$LOG)"
	# shellcheck disable=SC2086
	make $cleans >"$LOG" 2>&1
	# ход сборки — из вывода make: «make[N] -C <каталог пакета> compile» и «ERROR: … failed»
	# (собственные зависимости SDK, предупреждения конфигурации и т. п. — только в журнале)
	# shellcheck disable=SC2086
	make -k $compiles -j"$(nproc)" BUILD_LOG=1 >>"$LOG" 2>&1 &
	pid=$!
	tail -n 0 -f --pid=$pid "$LOG" 2>/dev/null | tr '\r' '\n' | awk -v dirs=" $* " '
		/ make\[[0-9]+\] -C .* compile$/ {
			n = split($(NF - 1), a, "/"); d = a[n]
			if (index(dirs, " " d " ") && !seen[d]++) { print "  building " d; fflush() }
		}
		/^ERROR: package\/.* failed to build/ {
			n = split($2, a, "/"); print "  FAILED   " a[n]; fflush()
		}'
	wait $pid || failed=1
fi

# в фиде — одна версия каждого пакета: из одного каталога собирается и несколько пакетов
# (halo + halo-preview, horizon-uc + zenith-uc), поэтому прежние ipk удаляются по имени пакета
# собранного файла, а не по имени каталога
built=$(find "$OUT" -maxdepth 1 -name '*.ipk' -newer "$STAMP" | sort)
rm -f "$STAMP"
for f in $built; do
	name=$(basename "$f" | sed 's/_.*//')
	for old in "$OUT/${name}_"*.ipk; do
		[ "$old" = "$f" ] || rm -f "$old"
	done
done
make package/index >/dev/null 2>&1 || die "make package/index failed"

T=$(( $(date +%s) - START ))
say "built in $(( T / 60 ))m$(( T % 60 ))s, $SDK/$OUT:"
for f in $built; do echo "  $(basename "$f")"; done
bad=""
for p in "$@"; do
	echo "$built" | grep -q "/${p}_" || bad="$bad $p"
done
[ -n "$bad$failed" ] || { say "indexes signed, all packages built"; exit 0; }
[ -n "$bad" ] || die "make reported errors, but every package has a new ipk: see $SDK/$LOG"
for p in $bad; do
	l=logs/package/feeds/halo/$p/compile.txt
	echo
	if [ -f "$l" ] && [ -z "$VERBOSE" ]; then
		say "$p: not built, end of $SDK/$l:"
		tail -n 15 "$l" | sed 's/^/  | /'
	else
		say "$p: not built"
	fi
done
echo
die "not built:$bad (one package in full: $0 -v $SDK <package>)"
