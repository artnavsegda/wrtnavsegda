#!/bin/sh
# Модули Halo после установки и удаления пакетов (postinst/postrm halo, halo-preview, halo-mod-*):
#
# 1. Манифест /usr/share/halo/modules/manifest.js — его подключает index.html Halo, и модули с
#    предзагрузкой начинают грузиться сразу, вместе с основным бандлом (на холодном старте,
#    без данных в браузере). Предзагрузка — файл preload в каталоге модуля
#    (modules/<имя>/preload, modules/dashboard/<label>/preload): его ставит пакет модуля.
#    Модули без preload (тяжёлые) в манифест не попадают — Halo ищет их сам, когда нужны.
#    lighttpd отдаёт *.js с Content-Encoding: gzip (шаблон Halo) — манифест сжат.
# 2. Halo рядом с aurora (halo-preview, корень веб-сервера /usr/share/aurora): CGI модулей
#    (/usr/share/halo/script/<имя>) — ссылками в /usr/share/aurora/script, настройки
#    веб-сервера модулей (/etc/lighttpd/halo.d) — строкой include в шаблоне aurora (aurora при
#    обновлении её стирает — следующий вызов вернёт). --detach-aurora — убрать и то и другое
#    (удаление halo-preview).
#
# При сборке образа — с IPKG_INSTROOT (корень образа).

R="${IPKG_INSTROOT}"
D="$R/usr/share/halo/modules"
AURORA="$R/usr/share/aurora"
TEMPLATE="$R/etc/lighttpd/template.conf"
INCLUDE='include "/etc/lighttpd/halo.d/*.conf"'
COMMENT='# Halo: настройки веб-сервера модулей (halo-preview, /usr/libexec/halo-modules)'

detach_aurora() {
	for l in "$AURORA"/script/*; do
		[ -L "$l" ] || continue
		case "$(readlink "$l")" in /usr/share/halo/script/*) rm -f "$l" ;; esac
	done
	# строки — точным сравнением (в include есть * и точки)
	if [ -f "$TEMPLATE" ] && grep -qxF "$INCLUDE" "$TEMPLATE"; then
		grep -vxF -e "$INCLUDE" -e "$COMMENT" "$TEMPLATE" > "$TEMPLATE.halo" && cat "$TEMPLATE.halo" > "$TEMPLATE"
		rm -f "$TEMPLATE.halo"
	fi
}

if [ "$1" = "--detach-aurora" ]; then
	detach_aurora
	exit 0
fi

# --- каталоги удалённых модулей: opkg оставляет их пустыми (modules/<имя>, modules/dashboard/<label>;
# script/<имя> — ниже, вместе со ссылками у aurora)
if [ -d "$D" ]; then
	for d in "$D"/* "$D"/dashboard/*; do
		[ -d "$d" ] && [ ! -L "$d" ] && [ "$d" != "$D/dashboard" ] || continue
		[ -n "$(ls -A "$d")" ] || rmdir "$d"
	done
fi

# --- манифест
if [ -d "$D" ]; then
	tmp="$D/.manifest.js.$$"
	trap 'rm -f "$tmp" "$tmp.gz"' EXIT
	{
		echo '// generated by /usr/libexec/halo-modules — do not edit'
		echo 'const m = (globalThis.__haloModules ??= {});'
		echo 'const css = (h) => { const l = document.createElement("link"); l.rel = "stylesheet"; l.href = new URL(h, import.meta.url).href; document.head.appendChild(l); };'
		for p in "$D"/*/preload "$D"/dashboard/*/preload; do
			[ -f "$p" ] || continue
			dir="${p%/preload}"
			key="${dir#$D/}"
			# только безопасные имена: попадают в код как есть
			case "$key" in *[!a-z0-9/-]*) continue ;; esac
			[ -f "$dir/index.js" ] || continue
			echo "m[\"$key\"] = import(\"./$key/index.js\").catch((e) => (console.warn(\"halo module $key:\", e), null));"
			# if, а не &&: без style.css у последнего модуля блок вернул бы 1 и манифест не записался
			if [ -f "$dir/style.css" ]; then echo "css(\"./$key/style.css\");"; fi
		done
	} > "$tmp" && gzip -9 -n -c "$tmp" > "$tmp.gz" && mv -f "$tmp.gz" "$D/manifest.js"
fi

# --- Halo рядом с aurora
if [ -d "$AURORA/halo" ] && [ -d "$AURORA/script" ]; then
	# CGI модулей: новые — ссылками, удалённых модулей — убрать
	for s in "$R"/usr/share/halo/script/*; do
		[ -d "$s" ] && [ ! -L "$s" ] || continue
		# каталог удалённого модуля opkg оставляет пустым — убрать
		[ -n "$(ls -A "$s")" ] || { rmdir "$s"; continue; }
		n="${s##*/}"
		[ -e "$AURORA/script/$n" ] || [ -L "$AURORA/script/$n" ] || ln -s "/usr/share/halo/script/$n" "$AURORA/script/$n"
	done
	for l in "$AURORA"/script/*; do
		[ -L "$l" ] || continue
		t=$(readlink "$l")
		case "$t" in /usr/share/halo/script/*) [ -n "$(ls -A "$R$t" 2>/dev/null)" ] || rm -f "$l" ;; esac
	done
	# настройки веб-сервера модулей — в шаблон aurora
	if [ -f "$TEMPLATE" ] && ! grep -qxF "$INCLUDE" "$TEMPLATE"; then
		printf '%s\n%s\n' "$COMMENT" "$INCLUDE" >> "$TEMPLATE"
	fi
fi
exit 0
