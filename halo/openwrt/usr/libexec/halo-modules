#!/bin/sh
# Манифест модулей Halo: /usr/share/halo/modules/manifest.js — его подключает index.html Halo,
# и модули с предзагрузкой начинают грузиться сразу, вместе с основным бандлом (на холодном
# старте, без данных в браузере). Предзагрузка — файл preload в каталоге модуля
# (modules/<имя>/preload, modules/dashboard/<label>/preload): его ставит пакет модуля.
# Модули без preload (тяжёлые) в манифест не попадают — Halo ищет их сам, когда они нужны.
#
# Вызывают postinst/postrm пакетов halo и halo-mod-*: файл всегда собран по тому, что
# установлено. При сборке образа — с IPKG_INSTROOT (корень образа).
# lighttpd отдаёт *.js с Content-Encoding: gzip (шаблон Halo) — манифест сжат.

# аргумент — другой каталог модулей (halo-preview: /usr/share/aurora/halo/modules)
D="${1:-${IPKG_INSTROOT}/usr/share/halo/modules}"
[ -d "$D" ] || exit 0

tmp="$D/.manifest.js.$$"
trap 'rm -f "$tmp" "$tmp.gz"' EXIT

{
	echo '// generated by /usr/libexec/halo-modules — do not edit'
	echo 'const m = (globalThis.__haloModules ??= {});'
	echo 'const css = (h) => { const l = document.createElement("link"); l.rel = "stylesheet"; l.href = new URL(h, import.meta.url).href; document.head.appendChild(l); };'
	for p in "$D"/*/preload "$D"/dashboard/*/preload; do
		[ -f "$p" ] || continue
		dir="${p%/preload}"
		key="${dir#$D/}"
		# только безопасные имена: попадают в код как есть
		case "$key" in *[!a-z0-9/-]*) continue ;; esac
		[ -f "$dir/index.js" ] || continue
		echo "m[\"$key\"] = import(\"./$key/index.js\").catch((e) => (console.warn(\"halo module $key:\", e), null));"
		[ -f "$dir/style.css" ] && echo "css(\"./$key/style.css\");"
	done
} > "$tmp" || exit 1

gzip -9 -n -c "$tmp" > "$tmp.gz" && mv -f "$tmp.gz" "$D/manifest.js"
